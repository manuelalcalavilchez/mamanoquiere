# ======================================================================
# Variables para Easypanel (App con Dockerfile, rama paradocker)
# Solo ADMIN_EMAIL, ADMIN_PASSWORD, SITE_URL y CRM_URL son recomendables;
# lo demás se genera solo y se guarda en /data/secrets.env.
# ======================================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=
SITE_URL=https://mamanoquiere.tudominio.es
CRM_URL=https://crm-mamanoquiere.tudominio.es

# Demo: muestra datos pendientes y fotos importadas, sin indexar. Producción: false
SHOW_PENDING=true
PRIVACY_VERSION=PENDIENTE-v0

# --- Opcionales ---
# DB_PASSWORD=            # interno; generado si se omite
# WEB_DB_PASSWORD=        # interno; generado si se omite
# DIRECTUS_SECRET=        # generado si se omite
# IP_HASH_SALT=           # generado si se omite
# PUBLIC_UMAMI_URL=
# PUBLIC_UMAMI_WEBSITE_ID=
# N8N_LEAD_WEBHOOK=
# EMAIL_TRANSPORT=smtp
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
