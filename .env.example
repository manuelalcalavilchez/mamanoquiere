# Copia este archivo a .env y rellénalo
POSTGRES_PASSWORD=cambia-esta-contraseña-larga
JWT_SECRET=genera-uno-con: openssl rand -hex 32
PUBLIC_URL=https://mamanoquiere.example.com
WEB_PORT=8080

# Primer acceso a la app (/app). Se crea al arrancar si no existe; después puedes vaciar estas dos líneas.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-contraseña

# Email (opcional, para Mensajes)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# WhatsApp vía Evolution API (opcional, para Mensajes)
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
